<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>{APP_FULL_NAME}_service</string>
        <key>KeepAlive</key>
        <true/>
        <key>ThrottleInterval</key>
        <integer>1</integer>
        <key>ProgramArguments</key>
        <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/Applications/{APP_NAME}.app/Contents/MacOS/service</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>WorkingDirectory</key>
        <string>/Applications/{APP_NAME}.app/Contents/MacOS/</string>
        <key>StandardErrorPath</key>
        <string>/tmp/{APP_LOWER_NAME}_service.err</string>
        <key>StandardOutPath</key>
        <string>/tmp/{APP_LOWER_NAME}_service.out</string>
    </dict>
</plist>
